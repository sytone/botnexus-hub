<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- These tests use framework and matching gateway references only. Never read machine/user feeds. -->
  <packageSources><clear /></packageSources>
  <fallbackPackageFolders><clear /></fallbackPackageFolders>
  <config><add key="globalPackagesFolder" value=".build/packages" /></config>
</configuration>
