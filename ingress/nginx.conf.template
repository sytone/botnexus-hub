# Two destination listeners, never Host-selected authentication boundaries.
pid /tmp/nginx.pid;
error_log /dev/stderr crit;
worker_processes 1;
events { worker_connections 512; }
http {
  access_log off;
  server_tokens off;
  client_max_body_size 64k;
  client_body_temp_path /tmp/client_temp;
  proxy_temp_path /tmp/proxy_temp;
  fastcgi_temp_path /tmp/fastcgi_temp;
  uwsgi_temp_path /tmp/uwsgi_temp;
  scgi_temp_path /tmp/scgi_temp;
  map $http_x_hub_proxy_secret $external_preauth {
    default 0;
    ~^${HUB_PROXY_SECRET}$ 1;
  }
  map $http_upgrade $is_websocket {
    default 0;
    ~*^websocket$ 1;
  }
  upstream private_hub { server 127.0.0.1:8785; }
  server {
    listen 8080 default_server;
    server_name _;
    # Health has no world data and remains safe for local service monitoring.
    location = /health { proxy_pass http://private_hub; }
    location ^~ /api/connect { return 404; }
    location = /api/login { return 404; }
    location = /api/logout { return 404; }
    location / {
      if ($external_preauth = 0) { return 403; }
      proxy_set_header X-Hub-Proxy-Secret "";
      proxy_set_header Authorization "";
      proxy_set_header Cookie "";
      proxy_set_header X-Forwarded-For "";
      proxy_set_header X-Forwarded-Proto "";
      proxy_set_header Host private-hub;
      proxy_pass http://private_hub;
    }
  }
  server {
    listen 8081 default_server;
    server_name _;
    # This listener NEVER proxies UI/operator routes, even with a spoofed Host.
    location ~ "^/api/connect/[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$" {
      if ($request_method != GET) { return 405; }
      if ($is_websocket = 0) { return 404; }
      if ($args != "") { return 400; }
      proxy_http_version 1.1;
      proxy_set_header Upgrade websocket;
      proxy_set_header Connection upgrade;
      proxy_set_header Authorization $http_authorization;
      proxy_set_header Cookie "";
      proxy_set_header X-Hub-Proxy-Secret "";
      proxy_set_header X-NetBird-User "";
      proxy_set_header X-NetBird-Groups "";
      proxy_set_header X-Forwarded-For "";
      proxy_set_header X-Forwarded-Proto "";
      proxy_set_header Host connector-ingress;
      proxy_read_timeout 75s;
      proxy_send_timeout 30s;
      proxy_buffering off;
      proxy_pass http://private_hub;
    }
    location / { return 404; }
  }
}
