# Never publish a real .env. Generate the ingress-only shared secret with scripts/configure.py.
HUB_HOST_PORT=8785
HUB_CONNECTOR_HOST_PORT=8788
HUB_PUBLIC_URL=https://hub.example.com
HUB_CONNECTOR_PUBLIC_URL=https://connect.example.com
# Set this only on your preauth proxy's upstream and the ingress, never in the browser.
HUB_PROXY_SECRET=replace-with-generated-proxy-secret
HUB_COMMIT=unknown
# Optional NetBird profile; not a core dependency.
NB_MANAGEMENT_URL=
NB_SETUP_KEY=
